QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN3_ASR_FALLBACK_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN3_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN3_USE_ALIGNER=true
QWEN3_CHUNK_SECONDS=600
QWEN3_MAX_BATCH_SIZE=8
QWEN3_MAX_NEW_TOKENS=2048
PYANNOTE_AUTH_TOKEN=
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda
ECHOSCRIBE_SEGMENT_TARGET_SECONDS=4.5
ECHOSCRIBE_SEGMENT_MAX_SECONDS=6.5
ECHOSCRIBE_SEGMENT_MAX_CHARS=28
ECHOSCRIBE_SEGMENT_SILENCE_SECONDS=0.8
# Volcengine Doubao speech ASR credentials
# New console: set VOLCENGINE_SPEECH_API_KEY only.
# Legacy console: set VOLCENGINE_SPEECH_APP_ID and VOLCENGINE_SPEECH_ACCESS_TOKEN instead.
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
VOLCENGINE_SPEECH_RESOURCE_ID=volc.bigasr.auc_turbo
