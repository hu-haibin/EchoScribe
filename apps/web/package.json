{
  "name": "echoscribe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "asr:up": "docker compose -f docker-compose.local-asr.yml up --build",
    "asr:down": "docker compose -f docker-compose.local-asr.yml down",
    "asr:logs": "docker compose -f docker-compose.local-asr.yml logs -f local-asr",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  }
}
